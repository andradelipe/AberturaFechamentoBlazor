@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main class="d-flex flex-column min-vh-100">
        <div class="top-row px-4 d-flex justify-content-end align-items-center">
            <button type="button"
                    class="btn btn-sm btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center theme-btn"
                    style="width: 36px; height: 36px; padding: 0;"
                    onclick="window.toggleAppTheme()"
                    title="Alternar tema claro/escuro"
                    aria-label="Alternar tema">
                <!-- Ícone Sol (aparece no modo escuro) -->
                <svg class="theme-icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="5"></circle>
                    <line x1="12" y1="1" x2="12" y2="3"></line>
                    <line x1="12" y1="21" x2="12" y2="23"></line>
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                    <line x1="1" y1="12" x2="3" y2="12"></line>
                    <line x1="21" y1="12" x2="23" y2="12"></line>
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                </svg>
                <!-- Ícone Lua (aparece no modo claro) -->
                <svg class="theme-icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                </svg>
            </button>
        </div>

        <article class="content px-4 flex-grow-1">
            @Body
        </article>

        <footer class="footer px-4 py-3 border-top text-center text-muted small mt-auto">
            Desenvolvido por <strong>Felipe Andrade</strong> &bull; <a href="mailto:adslfsa@gmail.com" class="text-muted text-decoration-none">adslfsa@gmail.com</a>
        </footer>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro não tratado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">🗙</span>
</div>
