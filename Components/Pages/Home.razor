@page "/"
@rendermode InteractiveServer
@inject HardwareService HardwareService
@inject AtividadeStateService StateService
@inject NavigationManager Navigation

<PageTitle>Novo Registro de Chamado</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 fw-bold mb-1">Novo Registro de Chamado</h1>
            <p class="text-muted mb-0 small">
                Preencha os dados abaixo para registrar o atendimento técnico e gerar os blocos de abertura e encerramento.
            </p>
        </div>
        <div>
            <a href="resumo" class="btn btn-outline-primary btn-sm me-2">Ver Resumo</a>
            <a href="registros" class="btn btn-outline-secondary btn-sm">Ver Registros (@StateService.Atividades.Count)</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensagemAlerta))
    {
        <div class="alert @classeAlerta alert-dismissible fade show shadow-sm" role="alert">
            @mensagemAlerta
            <button type="button" class="btn-close" @onclick="() => mensagemAlerta = null"></button>
        </div>
    }

    <EditForm Model="@modelo" OnValidSubmit="Registrar">
        <DataAnnotationsValidator />

        <!-- CARD 1: DADOS PRINCIPAIS DO CHAMADO -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-body-tertiary fw-bold py-3">
                Informações Gerais do Chamado
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <!-- ETIQUETA / CI -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Etiqueta Stellantis (CI)</label>
                        <div class="input-group">
                            <InputText class="form-control" placeholder="Ex: ABRBEOT00066003"
                                       @bind-Value="modelo.Etiqueta"
                                       @bind-Value:after="OnEtiquetaChanged" />
                            <button class="btn btn-outline-primary" type="button" @onclick="BuscarHardware">
                                Buscar
                            </button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(statusBusca))
                        {
                            <div class="mt-1 small @statusBuscaClass">@statusBusca</div>
                        }
                    </div>

                    <!-- SERIAL -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Número de Série</label>
                        <InputText class="form-control" placeholder="Serial do equipamento" @bind-Value="modelo.Serial" />
                    </div>

                    <!-- SOLICITANTE -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Solicitante</label>
                        <InputText class="form-control" placeholder="Nome do solicitante" @bind-Value="modelo.Solicitante" />
                    </div>

                    <!-- GALPÃO -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Galpão / Coluna</label>
                        <InputText class="form-control" placeholder="Ex: Galpão 01 - C12" @bind-Value="modelo.Galpao" />
                    </div>

                    <!-- SETOR / ROOM -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Setor / Room</label>
                        <InputText class="form-control" placeholder="Ex: Montagem / Sala 10" @bind-Value="modelo.RoomSetor" />
                    </div>

                    <!-- CELULAR / CONTATO -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Contato / Celular</label>
                        <InputText class="form-control" placeholder="(31) 9 9999-9999" @bind-Value="modelo.Celular" />
                    </div>

                    <!-- DESCRIÇÃO DA FALHA -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Descrição da Falha</label>
                        <InputTextArea class="form-control" rows="4" placeholder="Descreva detalhadamente o problema relatado..." @bind-Value="modelo.DescricaoFalha" />
                    </div>

                    <!-- AÇÃO CORRETIVA -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Ação Corretiva</label>
                        <InputTextArea class="form-control" rows="4" placeholder="Descreva os procedimentos realizados para a solução..." @bind-Value="modelo.AcaoCorretiva" />
                    </div>
                </div>

                <!-- SWITCH SUBSTITUIÇÃO -->
                <div class="form-check form-switch pt-3 mt-3 border-top">
                    <input class="form-check-input" type="checkbox" role="switch" id="checkSubstituicao"
                           @bind="modelo.EquipamentoSubstituido"
                           @bind:after="OnSubstituicaoToggle" />
                    <label class="form-check-label fw-bold text-primary" for="checkSubstituicao">
                        Houve Substituição de Equipamento
                    </label>
                </div>
            </div>
        </div>

        <!-- SEÇÃO CONDICIONAL: EQUIPAMENTOS SUBSTITUÍDOS -->
        @if (modelo.EquipamentoSubstituido)
        {
            <div class="row g-3 mb-4">
                <!-- COLUNA 1: EQUIPAMENTO INSTALADO -->
                <div class="col-lg-6">
                    <div class="card shadow-sm border-success h-100">
                        <div class="card-header bg-success text-white fw-bold py-2 d-flex justify-content-between align-items-center">
                            <span>Equipamento Instalado</span>
                            <span class="badge bg-white text-success small">Novo / Ativo</span>
                        </div>
                        <div class="card-body">
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">Serial</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="modelo.EqSerial" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">Item de Configuração (CI)</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="modelo.EqItemConfig" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">Modelo</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="modelo.EqModelo" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">Endereço IP</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="modelo.EqIp" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">Floor</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="modelo.EqFloor" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">Room</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="modelo.EqRoom" />
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label small fw-semibold">Aplicação</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="modelo.EqAplicacao" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold">Estado</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="modelo.EqEstado" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold">Subestado</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="modelo.EqSubstatus" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold">Função</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="modelo.EqFuncao" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- COLUNA 2: EQUIPAMENTO RECOLHIDO -->
                <div class="col-lg-6">
                    <div class="card shadow-sm border-warning h-100">
                        <div class="card-header bg-warning text-dark fw-bold py-2 d-flex justify-content-between align-items-center">
                            <span>Equipamento Recolhido</span>
                            <span class="badge bg-dark text-white small">Retirado</span>
                        </div>
                        <div class="card-body">
                            <div class="row g-2">
                                <div class="col-md-12">
                                    <label class="form-label small fw-semibold">Modelo</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="modelo.RecModelo" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">Floor</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="modelo.RecFloor" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">Room</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="modelo.RecRoom" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">Estado</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="modelo.RecEstado" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">Subestado</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="modelo.RecSubstatus" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- BOTÕES DE AÇÃO -->
        <div class="d-flex align-items-center gap-2 mb-4">
            <button type="submit" class="btn btn-primary px-4 py-2">
                Registrar Atividade
            </button>
            <button type="button" class="btn btn-outline-secondary px-3 py-2" @onclick="LimparForm">
                Limpar Formulário
            </button>
            <button type="button" class="btn btn-outline-primary px-3 py-2 ms-auto" @onclick='() => Navigation.NavigateTo("resumo")'>
                Ver Resumo
            </button>
        </div>
    </EditForm>
</div>

@code {
    private AtividadeModel modelo => StateService.FormAtual;

    private string? mensagemAlerta;
    private string classeAlerta = "alert-success";

    private string? statusBusca;
    private string statusBuscaClass = "text-muted";

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(modelo.Celular))
        {
            modelo.Celular = "(31)9 95426967";
        }
    }

    private void OnEtiquetaChanged()
    {
        if (!string.IsNullOrWhiteSpace(modelo.Etiqueta))
        {
            BuscarHardware();
        }
    }

    private void BuscarHardware()
    {
        if (string.IsNullOrWhiteSpace(modelo.Etiqueta))
        {
            statusBusca = "Informe a etiqueta para buscar.";
            statusBuscaClass = "text-warning";
            return;
        }

        var hw = HardwareService.BuscarPorTermo(modelo.Etiqueta);
        if (hw != null)
        {
            modelo.Serial = hw.SerialNumber;
            modelo.RoomSetor = hw.Room;
            modelo.Galpao = hw.Floor;

            if (modelo.EquipamentoSubstituido)
            {
                modelo.RecModelo = hw.Model;
            }

            statusBusca = $"Equipamento localizado: {hw.Model} (Serial: {hw.SerialNumber})";
            statusBuscaClass = "text-success fw-semibold";
        }
        else
        {
            statusBusca = "Equipamento não localizado na base de hardware.";
            statusBuscaClass = "text-danger";
        }
    }

    private void OnSubstituicaoToggle()
    {
        if (modelo.EquipamentoSubstituido && !string.IsNullOrWhiteSpace(modelo.Etiqueta))
        {
            var hw = HardwareService.BuscarPorTermo(modelo.Etiqueta);
            if (hw != null && string.IsNullOrWhiteSpace(modelo.RecModelo))
            {
                modelo.RecModelo = hw.Model;
            }
        }
    }

    private void Registrar()
    {
        if (string.IsNullOrWhiteSpace(modelo.DescricaoFalha) && string.IsNullOrWhiteSpace(modelo.Etiqueta))
        {
            mensagemAlerta = "Por favor, preencha pelo menos a descrição da falha ou a etiqueta do equipamento.";
            classeAlerta = "alert-warning";
            return;
        }

        var novaAtividade = new AtividadeModel
        {
            Id = Guid.NewGuid().ToString(),
            Data = DateTime.Now.ToString("dd/MM/yyyy"),
            DescricaoFalha = modelo.DescricaoFalha,
            AcaoCorretiva = modelo.AcaoCorretiva,
            Etiqueta = modelo.Etiqueta,
            Serial = modelo.Serial,
            Galpao = modelo.Galpao,
            RoomSetor = modelo.RoomSetor,
            Solicitante = modelo.Solicitante,
            Chamado = modelo.Chamado,
            Celular = modelo.Celular,
            EquipamentoSubstituido = modelo.EquipamentoSubstituido,
            EqSerial = modelo.EqSerial,
            EqIp = modelo.EqIp,
            EqItemConfig = modelo.EqItemConfig,
            EqModelo = modelo.EqModelo,
            EqFloor = modelo.EqFloor,
            EqRoom = modelo.EqRoom,
            EqAplicacao = modelo.EqAplicacao,
            EqEstado = modelo.EqEstado,
            EqSubstatus = modelo.EqSubstatus,
            EqFuncao = modelo.EqFuncao,
            RecModelo = modelo.RecModelo,
            RecFloor = modelo.RecFloor,
            RecRoom = modelo.RecRoom,
            RecEstado = modelo.RecEstado,
            RecSubstatus = modelo.RecSubstatus
        };

        StateService.AdicionarAtividade(novaAtividade);

        mensagemAlerta = "Atividade registrada com sucesso! Os dados foram adicionados aos Registros e ao Resumo Atual.";
        classeAlerta = "alert-success";
    }

    private void LimparForm()
    {
        StateService.FormAtual = new AtividadeModel();
        statusBusca = null;
        mensagemAlerta = null;
    }
}
